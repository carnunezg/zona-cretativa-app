# Copia este archivo como .env.local (desarrollo) y define las mismas
# variables en Vercel (Project → Settings → Environment Variables).

# Dominio público del sitio (para SEO / sitemap). Ej: https://zonacreativa.cl
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API. MISMO proyecto que el portal administrativo.
# Usa SOLO la "Project URL" y la clave pública "anon". Nunca la "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave compartida con el portal para que avise a la web que se actualice
# al guardar cambios (cualquier texto largo y aleatorio; NO es de Supabase).
REVALIDATE_SECRET=
